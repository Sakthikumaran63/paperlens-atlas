# PaperLens Atlas — Environment Configuration Template
PROJECT_NAME=paperlens-backend
ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL + pgvector in prod, SQLite in local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paperlens_db
# For SQLite local dev: DATABASE_URL=sqlite+aiosqlite:///./paperlens_v2.db

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Storage Limits
MAX_UPLOAD_SIZE_BYTES=20971520
UPLOAD_DIR=storage/uploads

# Primary AI: Local Model Provider
LOCAL_MODEL_NAME=deterministic-extractive
LOCAL_MODEL_PATH=
LOCAL_MODEL_ENDPOINT=
LOCAL_MODEL_VERSION=v1.0.0
LOCAL_CONFIDENCE_THRESHOLD=0.50

# Fallback AI: Google Gemini Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=3
GEMINI_FALLBACK_ENABLED=true

# Embedding Provider Configuration
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64

# Hybrid Retrieval Weights (Must sum to 1.0)
RETRIEVAL_SEMANTIC_WEIGHT=0.60
RETRIEVAL_SECTION_WEIGHT=0.25
RETRIEVAL_KEYWORD_WEIGHT=0.15
MAX_EVIDENCE_CONTEXT_TOKENS=1500
DEDUPLICATION_SIMILARITY_THRESHOLD=0.85

# Evidence Verification & Controlled Abstention Thresholds
QUOTE_MATCH_THRESHOLD=90
MIN_SUPPORT_SCORE_THRESHOLD=0.70

# Rate Limiting (Slowapi)
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_QUESTION=30/minute
