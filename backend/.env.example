PROJECT_NAME=paperlens-backend
ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/paperlens
CORS_ORIGINS=["*"]
SECRET_KEY=paperlens_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_UPLOAD_SIZE_BYTES=20971520
UPLOAD_DIR=storage/uploads
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=your_openai_or_compatible_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_SEMANTIC_WEIGHT=0.60
RETRIEVAL_SECTION_WEIGHT=0.25
RETRIEVAL_KEYWORD_WEIGHT=0.15
MAX_EVIDENCE_CONTEXT_TOKENS=1500
DEDUPLICATION_SIMILARITY_THRESHOLD=0.85
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
MIN_SUPPORT_SCORE_THRESHOLD=0.70
