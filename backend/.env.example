# PaperLens Atlas — Environment Configuration Template
PROJECT_NAME=paperlens-backend
ENV=development
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Cloud (Supabase PostgreSQL + pgvector) — RECOMMENDED FOR PRODUCTION
# Replace <PROJECT_REF> with your Supabase project reference slug.
# The password must be percent-encoded: @ → %40, # → %23
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Local PostgreSQL dev alternative
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paperlens_db

# SQLite local dev (no external DB required — some features limited)
# DATABASE_URL=sqlite+aiosqlite:///./paperlens_v2.db

# ─────────────────────────────────────────────────────────────────────────────
# Security & Authentication
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# ─────────────────────────────────────────────────────────────────────────────
# File Storage
# ─────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=20971520
UPLOAD_DIR=storage/uploads

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider — Google Gemini (Primary)
# Multiple API keys are rotated round-robin for throughput.
# Comma-separated list; single key also works.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_API_KEYS=<KEY_1>,<KEY_2>,<KEY_3>,<KEY_4>
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=3
GEMINI_FALLBACK_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider — Local Ollama (Offline Fallback)
# Install Ollama from https://ollama.com and pull a model:
#   ollama pull llama3.2
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────────────────────────────────────────
# Embedding Provider (OpenAI-compatible)
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=<YOUR_OPENAI_API_KEY>
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64

# ─────────────────────────────────────────────────────────────────────────────
# LLM Completion Provider (OpenAI-compatible, used by some services)
# ─────────────────────────────────────────────────────────────────────────────
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=<YOUR_OPENAI_API_KEY>
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ─────────────────────────────────────────────────────────────────────────────
# Hybrid Retrieval Weights (must sum to 1.0)
# ─────────────────────────────────────────────────────────────────────────────
RETRIEVAL_SEMANTIC_WEIGHT=0.60
RETRIEVAL_SECTION_WEIGHT=0.25
RETRIEVAL_KEYWORD_WEIGHT=0.15
MAX_EVIDENCE_CONTEXT_TOKENS=1500
DEDUPLICATION_SIMILARITY_THRESHOLD=0.85

# ─────────────────────────────────────────────────────────────────────────────
# Evidence Verification & Controlled Abstention
# ─────────────────────────────────────────────────────────────────────────────
QUOTE_MATCH_THRESHOLD=90
MIN_SUPPORT_SCORE_THRESHOLD=0.70

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting (Slowapi)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_QUESTION=30/minute
RATE_LIMIT_RECOMMENDATIONS=20/minute
