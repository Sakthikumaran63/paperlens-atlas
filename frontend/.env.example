# PaperLens Atlas — Frontend Environment Configuration Template

# ─────────────────────────────────────────────────────────────────────────────
# Backend API
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
# Production: VITE_API_URL=https://your-backend.onrender.com/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (Cloud PostgreSQL database)
# Get these from: https://supabase.com → Project → Settings → API
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Next.js aliases (used if migrating from Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
